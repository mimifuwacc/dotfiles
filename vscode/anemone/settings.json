{
  // workbench
  "workbench.colorTheme": "Electron Highlighter",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.activityBar.location": "default",
  "workbench.editor.editorActionsLocation": "titleBar",
  // auto save
  "files.autoSave": "afterDelay",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,

  // editor
  "editor.tabSize": 2,
  "editor.fontFamily": "'Calex Code JP', 'Source Han Code JP'",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "400",
  "editor.fontWeight": "normal",
  "editor.suggestSelection": "first",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "Cargo.toml": "Cargo.lock",
    "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
    "*.dart": "${capture}.g.dart",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "window.customTitleBarVisibility": "windowed",
  "prettier.resolveGlobalModules": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "terminal.external.linuxExec": "/usr/bin/kitty",
  "terminal.explorerKind": "both",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "javascript.updateImportsOnFileMove.enabled": "never",
  "task.allowAutomaticTasks": "on",
  "editor.fontSize": 14,
  "security.workspace.trust.enabled": false,
  "files.associations": {
    "*.css": "tailwindcss",
    "*.md": "markdown",
  },

  // copilot
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "*.txt": false,
    // "*.md": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,

  // python
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
  },

  // c/c++
  "[c]": {
    "editor.formatOnSaveMode": "file",
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "[cpp]": {
    "editor.formatOnSaveMode": "file",
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },

  // next.js
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
  },

  "git.autofetch": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
  },

  "redhat.telemetry.enabled": true,
  "accessibility.signals.terminalBell": {
    "sound": "on",
  },
  "haskell.manageHLS": "GHCup",
  "biome.suggestInstallingGlobally": false,
  "workbench.editor.empty.hint": "hidden",
  "githubPullRequests.pullBranch": "never",
  "background.enabled": true,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
  },

  "remote.autoForwardPorts": false,
  "terminal.integrated.accessibleViewPreserveCursorPosition": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "editor.wordWrap": "wordWrapColumn",
  "gitlens.views.commitDetails.files.layout": "tree",
  "workbench.sideBar.location": "right",
  "terminal.integrated.stickyScroll.enabled": false,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true,
  },
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "opus[1m]",
  "update.mode": "manual",
  // 'Prompt Glyphs' is last so it only serves the two prompt codepoints it
  // contains; the fonts before it keep supplying the metrics and everything
  // else. Ghostty routes those codepoints with font-codepoint-map instead,
  // which VSCode has no equivalent of.
  "terminal.integrated.fontFamily": "'Calex Code JP', 'Hack Nerd Font', 'Prompt Glyphs'",
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "claudeCode.useTerminal": true,
  "terminal.integrated.mouseWheelScrollSensitivity": 3,
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.browser.openLocalhostLinks": false,
  "workbench.panel.showLabels": false,
  "workbench.productIconTheme": "material-product-icons",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "chatgpt.composerEnterBehavior": "cmdAlways",
}
